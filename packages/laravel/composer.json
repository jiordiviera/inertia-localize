{
  "name": "jiordiviera/inertia-localize",
  "description": "Laravel localization for Inertia applications",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "InertiaLocalize\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "InertiaLocalize\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "InertiaLocalize\\InertiaLocalizeServiceProvider"
      ]
    }
  }
}
