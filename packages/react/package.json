{
  "name": "@inertia-localize/react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React adapter for Inertia Localize",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @inertia-localize/core build && tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@inertia-localize/core": "workspace:*"
  },
  "peerDependencies": {
    "@inertiajs/react": "^2.0.0 || ^3.0.0",
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@inertiajs/react": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2"
  }
}
