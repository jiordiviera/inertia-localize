{
  "name": "jiordiviera/inertia-localize",
  "description": "Laravel localization for Inertia applications",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Jiordi Kengne",
      "homepage": "https://jiordiviera.me"
    }
  ],
  "require": {
    "php": ">=8.2",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "inertiajs/inertia-laravel": "^2.0|^3.0"
  },
  "autoload": {
    "psr-4": {
      "InertiaLocalize\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "InertiaLocalize\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group=e2e",
    "test:e2e": "phpunit --group=e2e"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0"
  },
  "extra": {
    "laravel": {
      "providers": ["InertiaLocalize\\InertiaLocalizeServiceProvider"]
    }
  }
}
